# PlaySlot — .gitignore
#
# Security policy: never commit real secrets, env files with values, DB dumps,
# local Supabase state, or IDE configs that may embed tokens.
#
# Safe to commit: .env.example, supabase/migrations/, source code.

# ─── Dependencies ─────────────────────────────────────────────────────────────
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# ─── Next.js / build output ───────────────────────────────────────────────────
/.next/
/out/
/build/
/dist/
/.turbo/
/.swc/
*.tsbuildinfo

# Auto-generated by Next.js (no secrets; regenerated on install/build)
next-env.d.ts

# ─── Environment variables (NEVER commit real values) ─────────────────────────
.env
.env.*
.env*.local
.envrc
.env.backup
!.env.example
!.env.template
!.env.sample

# Common env variants (explicit — some tools create these outside .env.*)
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local

# ─── PlaySlot / Supabase / Vercel secrets (keep in dashboard or .env.local) ───
# NEXT_PUBLIC_SUPABASE_URL          — public, OK in env
# NEXT_PUBLIC_SUPABASE_ANON_KEY     — public (RLS protects data)
# SUPABASE_SERVICE_ROLE_KEY         — NEVER commit
# CRON_SECRET                       — NEVER commit
# RESEND_API_KEY                    — NEVER commit

# ─── TLS, keys, service accounts ──────────────────────────────────────────────
*.pem
*.pem.local
*.key
*.p12
*.pfx
*.crt
*.cer
*.csr
*.der
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
/certs/
/ssl/
localhost.pem
localhost-key.pem

# Cloud provider credential files
auth.json
token.json
tokens.json
credentials.json
credentials*.json
secrets.json
secrets*.json
secret.json
service-account*.json
*-credentials.json
*-service-account.json
google-services.json
GoogleService-Info.plist
firebase-adminsdk*.json
.aws/
.gcloud/
.gcp/
.docker/config.json

# Misc secret filename patterns
*.secret
*.secrets
*.token
*.tokens
apikey.txt
api-key.txt
api_keys.txt
stripe.env
.stripe/

# ─── SSH & package manager auth (personal tokens) ─────────────────────────────
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_dsa
*.ppk
.ssh/
.netrc
.npmrc
.yarnrc.yml.local
.pypirc
.htpasswd

# ─── Supabase local dev (tokens, DB passwords, branch state) ──────────────────
.supabase/
supabase/.temp/
supabase/.branches/
supabase/.env
supabase/.env.*
supabase/seed.local.sql
supabase/seed.local.*

# ─── Database dumps & backups (may contain real user data) ──────────────────────
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sql.gz
*.dump
*.backup
/backups/
/dumps/

# ─── Logs (may contain emails, tokens, IPs) ───────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ─── Hosting / deploy local state ─────────────────────────────────────────────
.vercel/
.netlify/
.firebase/
.firebaserc.local
.wrangler/
.dev.vars
wrangler.toml.local
docker-compose.override.yml
docker-compose.local.yml
docker-compose.*.local.yml

# ─── Monitoring / infra local config ───────────────────────────────────────────
.sentryclirc
sentry.properties.local
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
.pulumi/

# ─── IDE & AI assistants (local configs may embed API keys) ───────────────────
.idea/
.vscode/settings.json
.vscode/launch.json
*.code-workspace
*.swp
*.swo
*~

# Cursor — ignore local MCP config (may contain Supabase tokens)
.cursor/mcp.json
.cursor/*.local.json
.cursor/**/secrets/

# Claude / local AI overrides
.claude/settings.local.json
.claude/**/*.local.json
*.local.md

# Optional local-only folders (never share)
/secrets/
/private/
/credentials/
/.secrets/

# ─── Testing artifacts ────────────────────────────────────────────────────────
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.playwright/
*.lcov

# ─── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
ehthumbs.db

# ─── Temp / cache ─────────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
*.cache
.cache/
.temp/
tmp/
temp/
*.enc
*.encrypted
.secrets.baseline
